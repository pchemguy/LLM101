{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "defects": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "code": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "recommendation": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "severity",
          "section",
          "description",
          "evidence",
          "recommendation"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "extraction": {
      "type": "object"
    },
    "gost_compliance": {
      "type": "object"
    },
    "metadata": {
      "additionalProperties": true,
      "properties": {
        "audit_mode": {
          "type": "string"
        },
        "date": {
          "type": "string"
        },
        "document_id": {
          "type": "string"
        },
        "language": {
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "language",
        "audit_mode",
        "date"
      ],
      "type": "object"
    },
    "scores": {
      "type": "object"
    },
    "summary": {
      "type": "object"
    },
    "taxonomy_version": {
      "type": "string"
    }
  },
  "required": [
    "metadata",
    "scores",
    "defects",
    "gost_compliance",
    "summary"
  ],
  "title": "AuditReportPayload",
  "type": "object"
}